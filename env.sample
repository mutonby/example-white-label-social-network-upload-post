# Postgres
POSTGRES_USER=sveditor
POSTGRES_PASSWORD=sveditor_password
POSTGRES_DB=sveditor

# Redis
REDIS_URL=redis://redis:6379

# API
PORT=4000
# Required, 32+ random chars: openssl rand -hex 32 (the API refuses to start without it)
JWT_SECRET=
NODE_ENV=production
DATABASE_URL=postgresql://sveditor:sveditor_password@postgres:5432/sveditor
UPLOAD_POST_API_BASE=https://api.upload-post.com
UPLOAD_POST_API_KEY=api_key_upload-post
UPLOAD_POST_WEBHOOK_SECRET=replace_with_webhook_secret

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
